# APPEND ME

CONFIG_LOCALVERSION_AUTO=y

CONFIG_CMDLINE="kpti=0 nosoftlockup noirqdebug"
CONFIG_CMDLINE_EXTEND=y
CONFIG_OPTIMIZE_INLINING=y
CONFIG_JUMP_LABEL=y

#
# KernelSU
#
CONFIG_KSU=y
CONFIG_KSU_HACK_ARM64_BRANCH_LINK=y
# CONFIG_KSU_TAMPER_SYSCALL_TABLE is not set
CONFIG_KSU_LSM_SECURITY_HOOKS=y
# CONFIG_KSU_FEATURE_SULOG is not set
# CONFIG_KSU_FEATURE_ADBROOT is not set
# CONFIG_KSU_HOSTSREDIRECT is not set
# CONFIG_KSU_ENABLE_FULL_UID_CHECKS is not set
# CONFIG_KSU_THRONE_TRACKER_ALWAYS_THREADED is not set
# CONFIG_KSU_NOPRINTK is not set
# CONFIG_KSU_SHELL_HAS_SU_ALWAYS is not set
# CONFIG_KSU_DEBUG is not set
CONFIG_KSU_COMPILE_AS_C23=y
CONFIG_KSU_HEURISTIC_IN_TREE_BUILD=y

# kprobe integration test
CONFIG_KPROBES=n

# LE9/mm stuff
CONFIG_ANON_MIN_KBYTES=0
CONFIG_CLEAN_LOW_KBYTES=131072
CONFIG_CLEAN_MIN_KBYTES=0

# zram ofcourse
CONFIG_ZRAM=y

CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BIC=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_HTCP=y
CONFIG_TCP_CONG_HSTCP=y
CONFIG_TCP_CONG_HYBLA=y
CONFIG_TCP_CONG_VEGAS=y
CONFIG_TCP_CONG_NV=y
CONFIG_TCP_CONG_SCALABLE=y
CONFIG_TCP_CONG_LP=y
CONFIG_TCP_CONG_VENO=y
CONFIG_TCP_CONG_YEAH=y
CONFIG_TCP_CONG_ILLINOIS=y
CONFIG_TCP_CONG_DCTCP=y
CONFIG_TCP_CONG_CDG=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_DEFAULT_WESTWOOD=y

CONFIG_WIREGUARD=y

CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZRAM_DEFAULT_COMP_ALGORITHM="lz4"

CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y

CONFIG_NL80211_TESTMODE=n

# patched
CONFIG_AUDIT=y
CONFIG_SECURITY_SMACK=n
CONFIG_SECURITY_NETWORK=y

# strip
CONFIG_KALLSYMS_ALL=n
CONFIG_MODULE_SIG=n
CONFIG_DEBUG_KERNEL=n

CONFIG_FTRACE=n
CONFIG_TRACING=n

# restore /dev/diag support
CONFIG_DIAG_CHAR=y
CONFIG_DIAG_OVER_USB=y

CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=n
CONFIG_LD_DEAD_CODE_DATA_ELIMINATION=y

# add ch341 support
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CH341=y

